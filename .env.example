# ─────────────────────────────────────────────────────────────────────────
# LinkedIn Profile API — environment configuration
# Copy this file to `.env` and fill in the blanks. NEVER commit your real `.env`.
# ─────────────────────────────────────────────────────────────────────────

# --- Core API -------------------------------------------------------------

# Static API key that clients must send in the `X-API-Key` header.
# Generate a strong one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-strong-key

# Which data source powers the API. One of:  mock | fixture | linkedin
#   mock     -> deterministic synthetic data. No network, no account. (default)
#   fixture  -> canned JSON from tests/fixtures/profiles. Used by the test suite.
#   linkedin -> real browser-automation scraper. OFF by default. See warning below.
PROVIDER=mock

# Database connection. SQLite by default; a directory is created automatically.
# For Postgres:  postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/profiles.db

# Cache TTL: re-scrape a profile only if the cached copy is older than this
# many seconds. Default = 7 days.
CACHE_TTL_SECONDS=604800

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Run the async job worker inside the API process (fine for a demo). Set to
# false to run a standalone worker instead (see `make worker`).
RUN_INLINE_WORKER=true

# --- Politeness / rate limiting -------------------------------------------
# A randomized delay applied between remote fetch actions. This is courtesy
# rate-limiting to avoid hammering a remote host — it is NOT a guarantee
# against bot detection. See README "Known Limitations".
FETCH_MIN_DELAY_SECONDS=1.5
FETCH_MAX_DELAY_SECONDS=4.0

# --- LinkedIn scraper (ONLY read when PROVIDER=linkedin) ------------------
# WARNING: Automating a logged-in LinkedIn session violates LinkedIn's User
# Agreement and can get the account permanently banned. Use a THROWAWAY
# account you are willing to lose, never your personal one.
LI_EMAIL=
LI_PASSWORD=

# Where the authenticated Playwright storage state (cookies + localStorage)
# is written by scripts/login.py and read by the scraper.
SESSION_STATE_PATH=./session/state.json

# Headless scraping (the login script always runs headed so you can pass 2FA).
LINKEDIN_HEADLESS=true
